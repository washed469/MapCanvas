{
  "schemaVersion": 1,
  "id": "mapcanvas",
  "version": "${version}",
  "name": "MapCanvas",
  "description": "Display images and animated GIFs on maps in item frames.",
  "authors": ["washed469"],
  "contact": {
    "homepage": "https://modrinth.com/mod/mapcanvas",
    "sources": "https://modrinth.com/mod/mapcanvas"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/mapcanvas/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.washed.mapcanvas.client.MapcanvasDataGenerator"
    ],
    "client": [
      "com.washed.mapcanvas.client.MapcanvasClient"
    ],
    "main": [
      "com.washed.mapcanvas.Mapcanvas"
    ]
  },
  "mixins": [
    "mapcanvas.mixins.json",
    {
      "config": "mapcanvas.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}